{
  "name": "matra",
  "version": "0.1.0",
  "description": "Check that text will show and fit correctly in a font, box and language, for any script that HarfBuzz shapes. No headless browser.",
  "keywords": [
    "harfbuzz",
    "text",
    "shaping",
    "font",
    "tofu",
    "line-breaking",
    "text-fitting",
    "unicode",
    "i18n",
    "devanagari",
    "indic",
    "captions"
  ],
  "homepage": "https://github.com/yeypuchii/matra#readme",
  "bugs": "https://github.com/yeypuchii/matra/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeypuchii/matra.git"
  },
  "license": "MIT",
  "author": "Pulkit Mendiratta",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "matra": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/fetch-fixtures.ts",
    "golden:update": "node scripts/update-golden.ts && biome format --write test/golden",
    "conformance:update": "node scripts/update-conformance.ts && biome format --write test/conformance/known-differences.json",
    "bench": "node test/bench/run.ts",
    "smoke": "node test/smoke/smoke.mjs",
    "changeset": "changeset",
    "prepack": "pnpm build",
    "release": "changeset publish"
  },
  "dependencies": {
    "harfbuzzjs": "1.6.4",
    "linebreak": "2.0.0",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
